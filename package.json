{
  "name": "@tmrxjd/bemerged",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "pnpm": "10.28.0"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./headless-env": "./src/engine/headlessEnv.ts"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "dev": "pnpm play",
    "play": "node scripts/play-local.mjs --host localhost --port 5179 --strictPort",
    "play:host": "node scripts/play-local.mjs --host localhost --port 5179 --strictPort",
    "smoke:local-host": "node scripts/smoke-local-host.mjs",
    "type-check": "pnpm typecheck",
    "typecheck": "pnpm exec tsc -p tsconfig.json",
    "lint": "pnpm exec eslint src scripts",
    "lint:fix": "pnpm exec eslint src scripts --fix",
    "build": "pnpm typecheck",
    "validate": "pnpm lint && pnpm typecheck",
    "validate:ci": "pnpm validate && pnpm smoke:local-host",
    "clean": "rimraf dist",
    "preview": "pnpm exec vite preview",
    "changeset": "pnpm exec changeset",
    "version:packages": "pnpm exec changeset version",
    "release": "pnpm exec changeset publish",
    "publish:dry": "pnpm publish --dry-run",
    "prepublishOnly": "pnpm validate"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^6.4.1"
  },
  "packageManager": "pnpm@10.28.0"
}